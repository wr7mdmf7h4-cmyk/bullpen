# ─────────────────────────────────────────────────────────────────────────────
# Bullpen environment variables
# DATABASE_URL and AUTH_SECRET are required, and FINNHUB_API_KEY is needed for
# prices. Everything else is optional with a working fallback.
# Copy to .env (local) or add to Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Postgres connection string. On Neon use the *pooled* URL
# (host contains "-pooler") and keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/bullpen?sslmode=require"

# Optional. Direct (non-pooled) URL, used by migrations and the stock sync.
# Falls back to DATABASE_URL_UNPOOLED (set automatically by Vercel's Neon
# integration), then POSTGRES_URL_NON_POOLING, then DATABASE_URL.
DIRECT_URL=""

# REQUIRED. Signs session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional. Google sign-in. The Google button only appears when both are set.
# Authorised redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Needed for real prices (free tier: 60 calls/min). Bullpen only ever shows
# real market data; without a key, prices show as unavailable.
FINNHUB_API_KEY=""

# Optional. Real price history for charts (Twelve Data free plan: 800
# requests/day, 8/min). Each stock's history is downloaded once, then topped
# up. Without it, charts use only prices Bullpen has recorded itself.
TWELVE_DATA_API_KEY=""

# Optional. Comma-separated account emails that can open /admin (live
# sign-ups, who's online, latest trades). Unset = the page is a 404 for everyone.
ADMIN_EMAILS=""

# Development/tests only: "1" = deterministic fake prices so you can work
# offline. Ignored in production.
FAKE_MARKET_DATA=""

# Optional. Push updates for leaderboards/activity via Ably (free tier).
# Needs publish + subscribe capability. Without it, clients poll every 10s.
ABLY_API_KEY=""

# Optional. Distributed rate limiting via Upstash Redis (free tier).
# Without it, rate limits are enforced in memory per server instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional (recommended in production). Protects /api/cron/snapshot, which
# Vercel Cron calls daily. Vercel sends it as "Authorization: Bearer <secret>".
CRON_SECRET=""

# Tests only. A disposable Postgres database for `npm run test:integration`.
# It is migrated and TRUNCATED by the tests, never point it at real data.
TEST_DATABASE_URL=""
